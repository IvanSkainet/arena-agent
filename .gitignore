# Python
__pycache__/

# Tool state. These are not merely untracked -- they were the root cause of
# two packaging bugs: `.ruff_cache` (v4.157.0) and `.hypothesis` (600 files,
# v4.158.0) both rode into release archives because make_release_zip.py walks
# the working tree, and a local test run leaves them behind. The zip builder
# excludes them by shape now, but not littering the tree in the first place is
# the cheaper half of the fix.
.hypothesis/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyrefly_cache/
.benchmarks/
.tox/
.nox/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/

# Local data
memory/facts.jsonl
memory/history.jsonl
.arena-local-bridge/
audit.jsonl
audit.jsonl.*

# Backups (use git tags/releases, not files in repo)
backups/
*.zip
*.tar.gz
*.7z

# Logs
logs/
*.log

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local installer artefacts
tools/nssm.exe
tools/
node_modules/
.next/
.turbo/

# cloudflared binary — fetched on demand by the installer, not committed (~40 MB)
cloudflared
cloudflared.exe

# Token (NEVER commit)
token.txt

# Environment files (NEVER commit)
.env
.env.*
users.json

# Secrets & keys (NEVER commit)
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa
id_dsa
*.sqlite
*.db

# Temp
*.tmp
*.bak
*.orig
arena-test*/
arena-installer-v2/backup-*/

# Tests output
reports/shots/*.png
reports/recordings/*.mp4

# Queue data (runtime state, not source code)
queue/done/*.json
queue/failed/*.json
queue/tasks-archive-*.tgz

# Generated
start_ArenaUnifiedBridge.ps1
start_ArenaLocalBridge.ps1
start_ArenaMcpStream.ps1
start_ArenaMcpWs.ps1
start_ArenaTaskRunner.ps1
start_ArenaWebGateway.ps1
manual_restart.bat
recreate_task.ps1
install_nssm.ps1
ub_curr.py
ub_patched.py
patch_*.py
fix_*.py
debug*.bat
debug*.py
bump_v*.py
!dev/bump_version.py
release_v*.md
RESTORE_*.md
worklog.md

# Agent/deployment scratch artifacts
_agent_backups/
_selfheal*.sh
requests.jsonl
*.pid

# v4.163.0: these used to list only `.1`, so logrotate's SECOND rotation
# slipped through -- a 10 MB `requests.jsonl.2` was committed in c541f41e
# and has been carried in the repo ever since. make_release_zip.py already
# excludes rotated logs by prefix (it was taught to after one leaked into
# the v4.83.0 zip), but git itself never was. Glob the suffix instead of
# naming individual rotations.
bridge.log.*
requests.jsonl.*
audit.jsonl.*
reports/arena_kwin_windows_*.js
.arena_proposals/

# v4.92.0: never commit coverage artifacts or spec-kit scaffolding
.coverage
.coverage.*
coverage.xml
.specify/

# mutmut's own sqlite scratch file. The *results* live in
# scripts/mutation_cache.json, which IS committed -- that is the point of
# the cache: CI reuses a verdict this repo already earned. This file is
# per-run state and would just churn.
.mutmut-cache
