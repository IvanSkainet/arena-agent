{
  "name": "arena-bridge",
  "displayName": "Arena Unified Bridge",
  "description": "Mission Control for Arena Unified Bridge — ship status, autopilot, audit trail, MCP tools, and Serena code intelligence in your IDE.",
  "version": "0.3.0",
  "publisher": "IvanSkainet",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "arena",
    "bridge",
    "mcp",
    "ai-agent",
    "automation",
    "mission-control"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "arena.connect",
        "title": "Arena: Connect to Bridge",
        "icon": "$(plug)"
      },
      {
        "command": "arena.disconnect",
        "title": "Arena: Disconnect from Bridge"
      },
      {
        "command": "arena.showDashboard",
        "title": "Arena: Show Mission Control Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "arena.refreshAll",
        "title": "Arena: Refresh All",
        "icon": "$(refresh)"
      },
      {
        "command": "arena.runTool",
        "title": "Arena: Run MCP Tool"
      },
      {
        "command": "arena.screenshot",
        "title": "Arena: Take Desktop Screenshot"
      },
      {
        "command": "arena.autopilotStart",
        "title": "Arena: Start Autopilot from Goal"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arena-bridge",
          "title": "Arena Bridge",
          "icon": "resources/icons/arena.svg"
        }
      ]
    },
    "views": {
      "arena-bridge": [
        {
          "id": "arena.shipStatus",
          "name": "Ship Status"
        },
        {
          "id": "arena.autopilotRuns",
          "name": "Autopilot Runs"
        },
        {
          "id": "arena.capabilityGaps",
          "name": "Capability Gaps"
        },
        {
          "id": "arena.mcpTools",
          "name": "MCP Tools"
        }
      ]
    },
    "configuration": {
      "title": "Arena Bridge",
      "properties": {
        "arena.bridgeUrl": {
          "type": "string",
          "default": "",
          "description": "Bridge URL (e.g. https://your-bridge-host)"
        },
        "arena.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Connect to bridge on startup"
        },
        "arena.refreshInterval": {
          "type": "number",
          "default": 30,
          "description": "Auto-refresh interval in seconds (0 to disable)"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "watch": "npm run build -- --watch",
    "package": "npx @vscode/vsce package --no-dependencies",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^3.0.0"
  }
}
