# Direct dependencies for the reproducible CI test environment.
# The lock MUST be regenerated as a universal resolution, otherwise deps
# that only exist on other Python versions (e.g. async-timeout <3.11) are
# silently dropped and hash-mode installs fail on those matrix cells:
#   uv pip compile --universal --generate-hashes --strip-extras \
#     --python-version 3.10 \
#     --output-file=requirements-ci.lock requirements-ci.in
#
# --python-version 3.10 is REQUIRED, not cosmetic: without it uv resolves for
# the interpreter it happens to be running on, and every marker-guarded pin
# (async-timeout, exceptiongroup, tomli) silently vanishes from the lock --
# which is exactly the "cold-cache marker-drop" scripts/check_ci_lock.py
# exists to catch. Verified by reproducing it while adding playwright in
# v4.157.0: the bare command produced 0 marker lines, the flagged one 6.
aiohttp==3.14.3
psutil==7.2.2
websockets==16.1.1
requests==2.34.2
idna==3.18
beautifulsoup4==4.15.0
pytest==9.1.1
pytest-cov==7.1.0
hypothesis==6.164.0
ruff==0.16.1
mypy==1.19.1
pathspec==1.1.1
setuptools==83.0.0
wheel==0.47.0

# Test hardening: order shuffling + hang guard.
pytest-randomly==4.1.0
pytest-timeout==2.4.0

